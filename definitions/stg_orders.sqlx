config {
    type:"table",
    schema:"ecommerce_staging"
}
SELECT * EXCEPT(rn) FROM (
SELECT 
order_id,
customer_id,
customer_name,
product_category,
CAST(price as FLOAT64) As price, 
quantity,
PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%S', order_date) AS order_timestamp,
status,
ROW_NUMBER() OVER (PARTITION BY order_id ORDER BY
order_date DESC) AS rn 
FROM ${ref("raw_orders_external")}
WHERE _FILE_NAME NOT LIKE '%09-19-49%'
)
WHERE rn = 1

